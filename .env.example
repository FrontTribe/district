# App (Payload + Next.js). With `docker compose up`, Postgres is exposed on host port 5434.
DATABASE_URI=postgres://dev_user:your-password@127.0.0.1:5434/district_dev
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Seed scripts (dev only — separate DB from production)
# ALLOW_SEED=true          — required to run pnpm run seed:* against non-dev DATABASE_URI
# RE_SEED_TENANT_SUBDOMAIN=real-estate
# MOMENTO_SEED_TENANT_SUBDOMAIN=momento

# Rentlio (booking drawer, rates, reservations) — server-side only
# RENTAL_SECRET=your-rentlio-api-key
# RENTLIO_API_BASE=https://api.rentl.io/v1

# Boutique seed — dev Rentlio unit types when CMS rooms have no IDs (see /api/rentlio/options)
# BOUTIQUE_SEED_RENTLIO_PROPERTY_ID=33210
# BOUTIQUE_SEED_RENTLIO_SALES_CHANNEL_ID=56190
# BOUTIQUE_SEED_RENTLIO_UNIT_TYPE_IDS=68216,68217,68218,68219

# Optional — Google Maps (Location block + Momento map). Without it, OpenStreetMap embed is used.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=your-password
POSTGRES_DB=district_dev
