# App (Payload + Next.js). With `docker compose up`, Postgres is exposed on host port 5434.
DATABASE_URI=postgres://dev_user:your-password@127.0.0.1:5434/district_dev
PAYLOAD_SECRET=YOUR_SECRET_HERE

# CI/CD (GitHub Actions secrets for deployment.yml migration gate):
# DATABASE_URI   — Postgres connection string
# PAYLOAD_SECRET — same value as on the server

# Docker Compose `postgres` service (must match DATABASE_URI user/db/password)
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=your-password
POSTGRES_DB=district_dev
